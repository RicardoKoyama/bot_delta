<h1 class="page-title">Usuários Autorizados</h1>

<div class="toolbar">
  <a href="/usuarios/novo" class="btn-primary">
    <i class="fa-solid fa-plus"></i> Novo usuário
  </a>
</div>

<table class="table">
  <tr>
    <th>ID</th>
    <th>Nome</th>
    <th>Telefone</th>
    <th>Validade</th>
    <th>Ativo</th>
    <th>Admin</th>
    <th>Mensagem</th>
    <th>Token</th>
    <th>Ações</th>
  </tr>

  <% usuarios.forEach(u => { %>
    <tr>
      <td><%= u.id %></td>
      <td><%= u.nome %></td>
      <td><%= u.phone_number %></td>
      <td><%= u.validade %></td>

      <td>
        <% if (u.is_active) { %>
          <span class="status success">ATIVO</span>
        <% } else { %>
          <span class="status danger">INATIVO</span>
        <% } %>
      </td>

      <td><%= u.is_admin ? "Sim" : "Não" %></td>
      <td><%= u.mensagem_descricao || "-" %></td>
      <td><%= u.token ? "🔑" : "-" %></td>

      <td>
        <a href="/usuarios/editar/<%= u.id %>" class="action-link">
          <i class="fa-solid fa-pen"></i> Editar
        </a>
        |
        <a href="/usuarios/excluir/<%= u.id %>"
           class="action-link danger"
           onclick="return confirm('Excluir este usuário?')">
           <i class="fa-solid fa-trash"></i> Excluir
        </a>
      </td>
    </tr>
  <% }) %>
</
