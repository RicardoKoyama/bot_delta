<h1 class="page-title">Contas WhatsApp</h1>

<div class="toolbar">
  <a href="/contas/nova" class="btn-primary">
    <i class="fa-solid fa-plus"></i> Nova conta
  </a>
</div>

<table class="table">
  <tr>
    <th>ID</th>
    <th>Nome</th>
    <th>Telefone</th>
    <th>Status</th>
    <th>Atualizado</th>
    <th>Ações</th>
  </tr>

  <% contas.forEach(c => { %>
    <tr>
      <td><%= c.id %></td>
      <td><%= c.nome %></td>
      <td><%= c.telefone %></td>

      <td>
        <% if (c.status === 'ativo') { %>
          <span class="status success">ATIVO</span>
        <% } else if (c.status === 'qr') { %>
          <span class="status warning">QR PENDENTE</span>
        <% } else { %>
          <span class="status danger">DESCONECTADO</span>
        <% } %>
      </td>

      <td><%= c.atualizado_em %></td>

      <td>
        <a href="/contas/editar/<%= c.id %>" class="action-link">
          <i class="fa-solid fa-pen"></i> Editar
        </a>

        |
        <a href="/contas/excluir/<%= c.id %>" 
           class="action-link danger"
           onclick="return confirm('Excluir conta?')">
           <i class="fa-solid fa-trash"></i> Excluir
        </a>

        |
        <a href="/contas/qrcode/<%= c.id %>" class="action-link">
          <i class="fa-solid fa-qrcode"></i> QR
        </a>

        |
        <a href="/contas/restart/<%= c.id %>" class="action-link">
          <i class="fa-solid fa-rotate-right"></i> Reiniciar
        </a>
      </td>
    </tr>
  <% }) %>
</table>
