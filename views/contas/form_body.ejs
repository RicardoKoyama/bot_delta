<h1 class="page-title"><%= conta ? "Editar Conta WhatsApp" : "Nova Conta WhatsApp" %></h1>

<form method="POST" action="/contas/salvar" class="form">

  <% if (conta) { %>
    <input type="hidden" name="id" value="<%= conta.id %>">
  <% } %>

  <label class="form-label">Nome da Conta</label>
  <input type="text" name="nome" class="form-input"
         value="<%= conta ? conta.nome : '' %>" required />

  <label class="form-label">Telefone</label>
  <input type="text" name="telefone" class="form-input"
         value="<%= conta ? conta.telefone : '' %>" required />

  <button class="btn-primary" style="margin-top:20px">
    <i class="fa-solid fa-check"></i> Salvar
  </button>

  <a href="/contas" class="btn-secondary">Cancelar</a>
</form>
