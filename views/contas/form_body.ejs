<h1><%= conta ? "Editar Conta WhatsApp" : "Nova Conta WhatsApp" %></h1>

<form method="POST" action="/contas/salvar">

  <% if (conta) { %>
    <input type="hidden" name="id" value="<%= conta.id %>">
  <% } %>

  <label>Nome da Conta:</label><br/>
  <input type="text" name="nome" value="<%= conta ? conta.nome : '' %>" required><br/><br/>

  <label>Número:</label><br/>
  <input type="text" name="numero" value="<%= conta ? conta.numero : '' %>" required><br/><br/>

  <button type="submit">Salvar</button>
  <a href="/contas">Cancelar</a>

</form>
