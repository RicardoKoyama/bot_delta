<h1 class="page-title">Detalhes do Produto</h1>

<div class="content-card" style="padding:20px">

  <div style="display:flex; gap:30px">
    
    <div>
      <% if (detalhes.imagem_url) { %>
        <img src="<%= detalhes.imagem_url %>" style="width:250px; border-radius:10px;">
      <% } else { %>
        <div style="width:250px;height:250px;background:#eee;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#888">
          Sem imagem
        </div>
      <% } %>
    </div>

    <div style="font-size:16px; line-height:26px">
      <strong>Referência:</strong> <%= detalhes.codigo %><br>
      <strong>Nome:</strong> <%= detalhes.nome_abreviado %><br>
      <strong>Tamanho:</strong> <%= detalhes.tamanho %><br>
      <strong>Superfície:</strong> <%= detalhes.superficie %><br>
      <strong>Marca:</strong> <%= detalhes.marca %><br>
      <strong>Estoque:</strong> <%= detalhes.estoque %><br>
      <strong>m² por Caixa:</strong> <%= detalhes.m2_caixa %><br>
      <br>
      <a href="<%= detalhes.url_produto %>" target="_blank">🔗 Abrir no site</a>
    </div>
  </div>

  <br><br>
  <a href="/produtos" class="btn-secondary">← Voltar</a>

</div>
