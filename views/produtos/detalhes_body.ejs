<h1 class="page-title">Detalhes do Produto</h1>

<div class="content-card" style="padding:20px">

  <div style="display:flex; gap:30px">
    
    <div>
      <% if (detalhes.img_url) { %>
        <img src="<%= detalhes.img_url %>" style="width:250px; border-radius:10px;">
      <% } else { %>
        <div style="width:250px;height:250px;background:#eee;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#888">
          Sem imagem
        </div>
      <% } %>
    </div>

    <div style="font-size:16px; line-height:26px">
      <strong>Referência:</strong> <%= detalhes.cod_produto %><br>
      <strong>Nome:</strong> <%= detalhes.nome_abreviado %><br>
      <strong>Tamanho:</strong> <%= detalhes.dsc_tamanho_produtos %><br>
      <strong>Superfície:</strong> <%= detalhes.dsc_esp_superficie %><br>
      <strong>Marca:</strong> <%= detalhes.dsc_marca %><br>
      <strong>Estoque:</strong> <%= detalhes.sdo_saldo_estoque %><br>
      <strong>m² por Caixa:</strong> <%= detalhes.prd_m2_caixa %><br>
      <br>
      <a href="<%= detalhes.prd_link_produto %>" target="_blank">
        🔗 Abrir no site
      </a>
    </div>
  </div>

  <br><br>
  <a href="/produtos" class="btn-secondary">← Voltar</a>

</div>
