<h1 class="page-title">Produtos Delta</h1>

<form method="GET" action="/produtos" class="form-inline" style="margin-bottom:20px">
  <input type="text" name="busca" class="form-input"
         placeholder="Buscar nome ou referência"
         value="<%= busca %>" style="width:250px" />

  <button type="submit" class="btn-primary">Buscar</button>
  <a href="/produtos" class="btn-secondary" style="margin-left:10px">Limpar</a>
</form>

<a href="/produtos/exportar" class="export-link">⬇ Exportar CSV</a>

<table class="table" style="margin-top:20px">
  <tr>
    <th>Referência</th>
    <th>Nome</th>
    <th>ID Site</th>
    <th>Detalhes</th>
  </tr>

  <% produtos.forEach(p => { %>
    <tr>
      <td><%= p.cod_produto %></td>
      <td><%= p.nome_abreviado %></td>
      <td><%= p.id_site %></td>

      <td>
        <a href="/produtos/detalhes/<%= p.cod_produto %>" class="action-link">
          <i class="fa-solid fa-magnifying-glass"></i> Ver
        </a>
      </td>
    </tr>
  <% }) %>
</table>
